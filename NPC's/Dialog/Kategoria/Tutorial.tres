script = ExtResource("1_gpdld")
Dialog = "Welcome, my comrade! You've been appointed as a shopkeeper in this part of town. Your job is to satisfy your clients as best as possible. In the bottom-right corner, you have your warehouse—click it to show your items. Then, select the one that best fits your customer's needs and enjoy! ...Or not?"
